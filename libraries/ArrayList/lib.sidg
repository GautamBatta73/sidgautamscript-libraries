final ArrayList = () -> {
    var _props = {
        values: {},
        size: 0
    };

    pass {
        size: () -> _props.size,
        get: (idx) ->  _props.values[int(idx)],
        stringify: () -> str( _props.values),
        add: (obj) -> {
            _props.values[_props.size] = obj;
            _props.size = _props.size + 1;
        },
        clear: () -> {
            var oldVals = _props.values;
            _props.values = {};
            _props.size = 0;
            pass oldVals;
        },
        remove: (idx) -> {
            import "ListUtils";
            idx = int(idx);
            var arr = {};
            var oldVal =  _props.values[idx];

            _props.values.forEach((el, index) -> {
                unless(index == idx) {
                    arr[len(arr)] = el;
                }
            });

            _props.values = arr;
            _props.size = _props.size - 1;
            pass oldVal;
        }
    };
};