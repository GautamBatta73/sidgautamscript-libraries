final ArrayList = () -> {
    var _props = {
        values: {},
        size: 0
    };

    pass {
        size: () -> _props.size,
        get: (idx) ->  _props.values[int(idx)],
        stringify: () -> str( _props.values),
        add: (obj) -> {
            _props.values[_props.size] = obj;
            _props.size += 1;
        },
        clear: () -> {
            var oldVals = _props.values;
            _props.values = {};
            _props.size = 0;
            pass oldVals;
        },
        remove: (idx) -> {
            import "ListUtils";
            var arr = {};
            var oldVal =  _props.values[idx];
            var newArr = _props.values.deleteIndex(idx);
            _props.values = newArr;
            _props.size -= 1;
            pass oldVal;
        }
    };
};